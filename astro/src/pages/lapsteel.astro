---
import Layout from "@layouts/Layout.astro";
import ScoreTable from "@components/ScoreTable.astro";

import { getCollection } from "astro:content";
const scores = await getCollection("scores", ({ id }) => {
  return id.startsWith('lapsteel');
});
---

<Layout title="Lap Steel Scores">
  <ScoreTable type="lapsteel" scores={scores}/>
</Layout>
